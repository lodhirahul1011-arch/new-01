    {
      "name": "Tablet Delivery Flow",
      "item": [
        {
          "name": "Start Delivery Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"RFK-2891\",\n  \"company\": \"Flipkart\",\n  \"partnerName\": \"Ramesh Kumar\"\n}"
            },
            "url": {
