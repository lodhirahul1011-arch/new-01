{
  "info": {
    "name": "Dvaari Tablet APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tablet Pairing",
      "item": [
        {
          "name": "Create Pairing Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tablet-bootstrap-secret",
                "value": "{{tabletBootstrapSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"tablet-demo-01\",\n  \"displayName\": \"Main Door Tablet\",\n  \"appVersion\": \"1.0.0\",\n  \"platform\": \"android_tablet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/pairing/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "pairing",
                "session"
              ]
            }
          }
        },
        {
          "name": "Claim Pairing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{tabletQrToken}}\",\n  \"displayName\": \"Main Door Tablet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/pairing/claim",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "pairing",
                "claim"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tablet Device Auth",
      "item": [
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "config"
              ]
            }
          }
        },
        {
          "name": "Update Wi-Fi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ssid\": \"MyWiFi\",\n  \"connected\": true,\n  \"signalStrength\": 88,\n  \"ipAddress\": \"192.168.1.22\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/setup/wifi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "setup",
                "wifi"
              ]
            }
          }
        },
        {
          "name": "Patch Setup",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Main Door Tablet\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"language\": \"en\",\n  \"theme\": \"light\",\n  \"simpleModeEnabled\": false,\n  \"onboardingCompleted\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "setup"
              ]
            }
          }
        },
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"online\",\n  \"batteryLevel\": 90,\n  \"networkType\": \"wifi\",\n  \"appVersion\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/heartbeat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "heartbeat"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tablet Visitor Flow",
      "item": [
        {
          "name": "Create Visitor Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"visitor\",\n  \"visitorName\": \"Courier\",\n  \"note\": \"At the main gate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/visitor-sessions",
