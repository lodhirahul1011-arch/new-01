              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"note\": \"Please allow entry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/visitor-sessions/{{visitorSessionId}}/respond",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "visitor-sessions",
                "{{visitorSessionId}}",
                "respond"
              ]
            }
          }
        }
      ]
