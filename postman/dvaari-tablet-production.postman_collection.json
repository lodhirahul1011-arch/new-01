              "path": [
                "api",
                "v1",
                "tablet",
                "pairing",
                "claim"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{pairQrToken}}\",\n  \"displayName\": \"Main Gate Tablet\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "List Linked Tablets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "devices"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Rename Tablet Device",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/devices/{{tabletDeviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "devices",
                "{{tabletDeviceId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Lobby Tablet\",\n  \"simpleModeEnabled\": false\n}"
            }
          },
          "response": []
        }
      ]
    },
