    {
      "name": "Doorbell and Visitor Flow",
      "item": [
        {
          "name": "Create Visitor Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/visitor-sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "visitor-sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"visitor\",\n  \"note\": \"Doorbell pressed\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status ok\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"visitorSessionId\", json.data.session.id || \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "List Visitor Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/visitor-sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "visitor-sessions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Respond Visitor Session",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/visitor-sessions/{{visitorSessionId}}/respond",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "visitor-sessions",
                "{{visitorSessionId}}",
                "respond"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Initiate Doorbell Call (3-ring)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/calls/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "calls",
                "initiate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"doorbell\",\n  \"visitorSessionId\": \"{{visitorSessionId}}\",\n  \"ringIncrement\": 3,\n  \"autoStartThreshold\": 3,\n  \"forceStart\": true,\n  \"liveVideoRequested\": true\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status ok\", function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const json = pm.response.json();",
                  "const call = json.data.call || json.data.item || json.data;",
                  "if (call && call.id) pm.collectionVariables.set(\"callId\", call.id);"
                ]
              }
            }
          ]
        }
      ]
    },
