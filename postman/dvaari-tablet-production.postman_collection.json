    {
      "name": "Live Call and WebRTC Signaling",
      "item": [
        {
          "name": "Initiate Delivery Call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{tabletDeviceId}}"
              },
              {
                "key": "x-device-secret",
                "value": "{{tabletDeviceSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/{{tabletDeviceId}}/calls/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "{{tabletDeviceId}}",
                "calls",
                "initiate"
              ]
            },
