{
  "info": {
    "name": "Dvaari Tablet Production",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Production-focused tablet API collection for signup/login, pairing, setup, sync, doorbell, delivery, live call, OTP, recordings, confirm delivery, and end-call flows."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "mobileAccessToken",
      "value": ""
    },
    {
      "key": "tabletBootstrapToken",
      "value": "bootstrap-test-token"
    },
    {
      "key": "tabletDeviceId",
      "value": "TAB-DEMO-001"
    },
    {
      "key": "tabletDeviceSecret",
      "value": ""
    },
    {
      "key": "pairQrToken",
      "value": ""
    },
    {
      "key": "pairingCodeId",
      "value": ""
    },
    {
      "key": "deliverySessionId",
      "value": ""
    },
    {
      "key": "visitorSessionId",
      "value": ""
    },
    {
      "key": "callId",
      "value": ""
    },
    {
      "key": "recordingId",
      "value": ""
    },
    {
      "key": "deliveryOrderId",
      "value": "ORDER-1001"
    },
    {
      "key": "deliveryAwbCode",
      "value": "AWB-1001"
    },
    {
      "key": "otpCode",
      "value": "1234"
    },
    {
      "key": "identifier",
      "value": "+919999999999"
    }
  ],
  "item": [
    {
      "name": "Tablet Signup Login",
      "item": [
        {
          "name": "Request OTP (email/mobile)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/auth/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "auth",
                "request-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Verify OTP Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/auth/resend-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "auth",
                "resend-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"purpose\": \"login\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tablet Pairing and Naming",
      "item": [
        {
          "name": "Create Pairing Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tablet-bootstrap-token",
                "value": "{{tabletBootstrapToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/pairing/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tablet",
                "pairing",
                "session"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{tabletDeviceId}}\",\n  \"displayName\": \"Dvaari Tablet\",\n  \"appVersion\": \"1.0.0\",\n  \"platform\": \"android_tablet\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status ok\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"pairQrToken\", json.data.qrToken || \"\");",
                  "pm.collectionVariables.set(\"tabletDeviceSecret\", json.data.deviceSecret || \"\");",
                  "pm.collectionVariables.set(\"tabletDeviceId\", json.data.deviceId || pm.collectionVariables.get(\"tabletDeviceId\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Claim Pairing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobileAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tablet/pairing/claim",
              "host": [
                "{{baseUrl}}"
