{
  "info": {
    "name": "Dvaari NFC Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Settings Overview",
      "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": { "raw": "{{baseUrl}}/api/v1/settings", "host": ["{{baseUrl}}"], "path": ["api","v1","settings"] } }
    },
    {
      "name": "NFC Overview",
      "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": { "raw": "{{baseUrl}}/api/v1/nfc/cards/overview", "host": ["{{baseUrl}}"], "path": ["api","v1","nfc","cards","overview"] } }
    },
    {
      "name": "Register NFC Card",
      "request": {
        "method": "POST",
        "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],
        "body": { "mode": "raw", "raw": "{\n  \"label\": \"My Access Card\",\n  \"uid\": \"04AABB4521\",\n  \"cardType\": \"access\",\n  \"meta\": {\n    \"source\": \"settings_nfc\",\n    \"registrationMethod\": \"manual\"\n  }\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/nfc/cards", "host": ["{{baseUrl}}"], "path": ["api","v1","nfc","cards"] }
      }
    },
    {
      "name": "Verify NFC Access",
      "request": {
        "method": "POST",
        "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],
        "body": { "mode": "raw", "raw": "{\n  \"uid\": \"04AABB4521\",\n  \"flow\": \"delivery_access\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/nfc/verify-access", "host": ["{{baseUrl}}"], "path": ["api","v1","nfc","verify-access"] }
      }
    },
    {
      "name": "NFC Access Logs",
      "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": { "raw": "{{baseUrl}}/api/v1/nfc/access-logs", "host": ["{{baseUrl}}"], "path": ["api","v1","nfc","access-logs"] } }
    },
    {
      "name": "Delivery Access Methods",
      "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": { "raw": "{{baseUrl}}/api/v1/delivery-access/methods", "host": ["{{baseUrl}}"], "path": ["api","v1","delivery-access","methods"] } }
    }
  ]
}
