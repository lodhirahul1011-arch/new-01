{
  "info": {
    "name": "Dvaari Mobile Delivery Access & Recordings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Delivery Access",
      "item": [
        {
          "name": "Verify Context",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/delivery-access/deliveries/{{deliveryId}}/verify-context"
          }
        },
        {
          "name": "List Zones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/delivery-access/zones?status=active"
          }
        },
        {
          "name": "Create Zone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Zone Two\", \"type\": \"locker\", \"locationDescription\": \"Near lobby left side locker\", \"accessCode\": \"1234\"}"
            },
            "url": "{{baseUrl}}/api/v1/delivery-access/zones"
          }
        },
        {
          "name": "Select Zone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"zoneId\": \"{{zoneId}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/delivery-access/deliveries/{{deliveryId}}/select-zone"
          }
        },
        {
          "name": "Select Verification Method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"method\": \"approve_in_app\"}"
            },
            "url": "{{baseUrl}}/api/v1/delivery-access/deliveries/{{deliveryId}}/select-verification-method"
          }
        },
        {
          "name": "Zone Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/delivery-access/zones/{{zoneId}}/status"
          }
        }
      ]
    },
    {
      "name": "Delivery Recordings",
      "item": [
        {
          "name": "List Recordings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/recordings?status=all&days=30"
          }
        },
        {
          "name": "Recording Metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}/recording"
          }
        },
        {
          "name": "Recording Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}/recording/detail"
          }
        },
        {
          "name": "Recording Share",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}/recording/share"
          }
        },
        {
          "name": "Recording Download Redirect",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}/recording?download=1"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "deliveryId",
      "value": ""
    },
    {
      "key": "zoneId",
      "value": ""
    }
  ]
}