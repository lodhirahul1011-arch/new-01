<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/native_call_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingLeft="12dp"
  android:paddingTop="10dp"
  android:paddingRight="12dp"
  android:paddingBottom="10dp"
  android:background="@drawable/native_call_notification_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/native_call_avatar"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="@drawable/native_call_avatar_bg"
      android:gravity="center"
      android:text="V"
      android:textColor="#55C7F4"
      android:textSize="24sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginLeft="12dp"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
          android:id="@+id/native_call_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:singleLine="true"
          android:ellipsize="end"
          android:text="Visitor at Door"
          android:textColor="#FFFFFF"
          android:textSize="17sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/native_call_now"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="now"
          android:textColor="#B7B7B9"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/native_call_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Incoming voice call"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/native_call_decline"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/native_call_decline_bg"
      android:gravity="center"
      android:text="Decline"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />

    <Space
      android:layout_width="14dp"
      android:layout_height="1dp" />

    <TextView
      android:id="@+id/native_call_answer"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/native_call_answer_bg"
      android:gravity="center"
      android:text="Answer"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
